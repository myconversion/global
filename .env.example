# ---------------------------------------------------------------------------
# Supabase — Frontend (public, safe to commit to client bundle)
# ---------------------------------------------------------------------------
# Project reference ID (found in Settings > General)
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Anon/public key — intentionally public; used by the browser client.
# This key is subject to RLS policies and cannot bypass row-level security.
# Obtain from: Supabase Dashboard > Settings > API > Project API keys > anon / public
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Full project URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ---------------------------------------------------------------------------
# Supabase — Server-side only (NEVER expose in frontend or commit to git)
# ---------------------------------------------------------------------------
# Service role key — bypasses RLS, has full database access.
# Used ONLY in Edge Functions via Deno.env.get("SUPABASE_SERVICE_ROLE_KEY").
# Obtain from: Supabase Dashboard > Settings > API > Project API keys > service_role
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # set in Supabase Edge Function secrets

# ---------------------------------------------------------------------------
# Edge Function environment (set via: supabase secrets set KEY=value)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS
# ALLOWED_ORIGINS="https://dashboard.myconversion.app"

# Comma-separated list of allowed WhatsApp API hostnames (SSRF protection)
# ALLOWED_WA_HOSTS="api.evolution-api.com,your-wa-provider.com"
